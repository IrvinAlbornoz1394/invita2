# Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo para scripts (crear admins). Nunca en el navegador ni en Vercel si no hace falta.
SUPABASE_SECRET_KEY=sb_secret_...

# URL pública del sitio (vista previa en WhatsApp, enlaces del panel)
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
# WhatsApp de contacto en la landing (lada + número, sin + ni espacios)
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Invitación de ejemplo que enlaza la landing (opcional)
NEXT_PUBLIC_DEMO_SLUG=
